<?xml version="1.0"?>
<package format="3">
  <name>airmouse_detection</name>
  <version>0.1.0</version>
  <description>Survivor (person) detection on the drone's colour camera: ROS 2 wrapper around the
  detection team's YOLO11n model (external/NIDAR-Automation).</description>
  <maintainer email="noreply@example.com">AirMouse team</maintainer>
  <license>Proprietary</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
