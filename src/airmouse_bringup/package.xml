<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>airmouse_bringup</name>
  <version>0.0.1</version>
  <description>All launch files and parameter files for the NIDAR AirMouse navigation stack.</description>
  <maintainer email="lily207moon@gmail.com">AirMouse Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>airmouse_description</exec_depend>
  <exec_depend>airmouse_nav</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
